{
  "manifestVersion": 5,
  "id": "com.moodbook.indesign.sync",
  "name": "moodbook",
  "version": "1.5.4",
  "main": "index.html",
  "host": { "app": "ID", "minVersion": "18.5.0" },
  "entrypoints": [
    {
      "type": "panel",
      "id": "moodbookPanel",
      "label": { "default": "moodbook" },
      "minimumSize": { "width": 260, "height": 320 },
      "maximumSize": { "width": 2000, "height": 3000 },
      "preferredDockedSize": { "width": 320, "height": 560 },
      "preferredFloatingSize": { "width": 340, "height": 600 },
      "icons": [
        { "width": 23, "height": 23, "path": "icons/panel-dark.png", "scale": [1, 2], "theme": ["darkest", "dark", "medium"] },
        { "width": 23, "height": 23, "path": "icons/panel-light.png", "scale": [1, 2], "theme": ["lightest", "light"] }
      ]
    }
  ],
  "icons": [ { "width": 48, "height": 48, "path": "icons/plugin.png", "scale": [1, 2], "theme": ["all"], "species": ["pluginList"] } ],
  "requiredPermissions": {
    "network": { "domains": ["https://qjxrbepkpqgjnubjdhmp.supabase.co"] },
    "localFileSystem": "fullAccess"
  }
}
